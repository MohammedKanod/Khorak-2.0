# KHORAK Environment Configuration
# Copy to .env (and backend/.env if running separately)

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/khorak?schema=public"
JWT_SECRET="replace-with-a-secure-32-char-random-secret-in-production"
JWT_REFRESH_SECRET="replace-with-a-different-32-char-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=4000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
API_BASE_URL="http://localhost:4000"

# Local persistent file storage directory for delivery and spoilage evidence
STORAGE_CONFIGURATION="local"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5

# Configurable alert thresholds
EXPIRY_WARNING_DAYS=30
REORDER_WARNING_DAYS=7
REORDER_CRITICAL_DAYS=3
DEFAULT_ESTIMATED_DAILY_CONSUMPTION=8

