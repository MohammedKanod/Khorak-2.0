{
  "name": "khorak-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:start": "npm --prefix backend run db:start",
    "migrate": "npm --prefix backend run prisma:migrate",
    "seed": "npm --prefix backend run prisma:seed",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "test": "npm --prefix backend test && npm --prefix frontend test"
  }
}

